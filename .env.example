# Salin menjadi .env lalu isi sendiri. Jangan commit .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sortik_dev
DB_USER=postgres
DB_PASS=

# Jumlah reverse proxy di depan aplikasi, untuk membaca IP asli dari X-Forwarded-For.
# 0 = langsung (lokal). Di balik satu Nginx/load balancer: 1. Terlalu besar = IP bisa dipalsukan.
PROXY_TEPERCAYA=0
# Batas akun baru per IP per jam (naikkan sementara bila menjalankan tes balapan stok berulang)
BATAS_DAFTAR_PER_JAM=10
